NEXT_PUBLIC_SUPABASE_URL=https://skiirweoiaeueoskjwhy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_server_only_secret_key

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_server_only_test_key_secret
RAZORPAY_WEBHOOK_SECRET=choose_this_in_the_razorpay_webhook_settings

# Transactional payment receipts. Verify the sender domain in Resend first.
RESEND_API_KEY=re_your_server_only_api_key
PAYMENT_CONFIRMATION_FROM_EMAIL=Jalna Investment Summit <registrations@updates.example.com>

# Public event and support information used on the contact/policy pages.
EVENT_ORGANIZER_NAME=Your legal business or organisation name
EVENT_SUPPORT_EMAIL=support@example.com
EVENT_SUPPORT_PHONE=+91 00000 00000
EVENT_DATE=Event date and time
EVENT_LOCATION=Venue or online access details

# Optional localhost-only admin alias. Never configure these in production.
LOCAL_ADMIN_USERNAME=your_local_username
LOCAL_ADMIN_PASSWORD=your_local_password
LOCAL_ADMIN_SUPABASE_EMAIL=hidden_supabase_admin_email
LOCAL_ADMIN_SUPABASE_PASSWORD=hidden_strong_supabase_password
